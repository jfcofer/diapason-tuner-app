# The pinned toolchain. This file is the single source of truth for every version in the repo.
#
# docs/DEVELOPMENT.md §1 documents *why* each pin is what it is; this file is what tools/doctor.sh
# and CI actually enforce. Changing a value here is its own task and its own ADR (AGENTS.md §8).
#
# Shell-sourceable and grep-able on purpose: consumed by tools/*.sh and .github/workflows/*.yml.

# Flutter / Dart — Flutter 3.47.1 stable (2026-08-19) carries Dart 3.13.1.
FLUTTER_VERSION=3.47.1
DART_VERSION=3.13.1

# flutter_rust_bridge. Codegen binary, Rust crate and Dart package must match EXACTLY.
# Version drift here is the single most common build failure in this stack.
FRB_VERSION=2.13.0

# Rust. rust-toolchain.toml's channel must equal this; Cargo.toml's rust-version is the MSRV.
# An exact release, never "stable" - see docs/adr/0015.
RUST_VERSION=1.98.0

# Java. AGP is validated on 17 and partially 21; Flutter Android builds FAIL on JDK 25
# (flutter/flutter#187223). Pin 21 and point Flutter at it with `flutter config --jdk-dir`.
JAVA_MAJOR=21
JAVA_SDKMAN_ID=21.0.12+1.1-tem

# Android. NDK r28+ aligns shared libraries to 16 KB by default (arm64-v8a, x86_64).
# targetSdk 36 is required for Google Play submissions from 2026-08-31. minSdk 28 is the first
# API with AAudio input presets, which the tuner needs (docs/adr/0019).
ANDROID_NDK_VERSION=30.0.16138531
ANDROID_COMPILE_SDK=36
ANDROID_TARGET_SDK=36
ANDROID_MIN_SDK=28

# iOS. Matches Flutter 3.47's own iOS 15 minimum.
IOS_DEPLOYMENT_TARGET=15.0

# Repo check tools (`just lint-ci`). install-action does not package actionlint, so CI installs
# this exact release with actionlint's own download script.
ACTIONLINT_VERSION=1.7.12
# CocoaPods' xcodeproj gem generates the iOS project (just ios-project). ios-project-check compares
# its output byte for byte, so a different gem version is a different serialisation: pin it.
XCODEPROJ_VERSION=1.28.1
# Kotlin formatter (docs/adr/0023). The release jar from Maven Central, verified against the SHA-256
# Maven Central publishes beside it. tools/ktfmt.sh installs it; there is no other install path.
KTFMT_VERSION=0.64
KTFMT_SHA256=5b3d5286fd2defcc7dc8e28c21ddf156cc6b2d8682bdcd929ce4333e7a6201f2

# Monorepo orchestration. Melos 7+ builds on pub workspaces and has no melos.yaml (ADR-0006).
MELOS_VERSION=8.5.0
